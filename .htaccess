# Lovačka evidencija – zaštita mapa s podacima i kodom
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|podaci|vendor)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(config\.php|composer\.(json|lock))$ - [F,L]
</IfModule>

<FilesMatch "^(config\.php|composer\.(json|lock)|\..*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
</IfModule>
